# ─────────────────────────────────────────────────────────────
# MatchIQ Website — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Dependencies (never commit these — run npm install instead) ──
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ──
.next/
out/
build/

# ── Environment variables (secrets — never commit) ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ── Debug logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS files ──
.DS_Store
Thumbs.db
desktop.ini

# ── Editor folders ──
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── TypeScript cache ──
*.tsbuildinfo
next-env.d.ts

# ── Testing ──
/coverage

# ── Deployment ──
.vercel
